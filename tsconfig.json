{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "effectweb",
    "types": ["node"],
    "paths": { "effectweb/jsx-runtime": ["./packages/runtime/src/jsx-runtime.ts"] }
  },
  "include": ["packages/*/src", "vite.config.ts"]
}
