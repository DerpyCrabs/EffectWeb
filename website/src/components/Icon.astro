---
// Inline icons drawn with the text's color. The web fonts cover Latin only, so arrows and
// symbols typed as characters would render in whatever font the system falls back to.
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'search' | 'theme' | 'menu';
  size?: number;
}
const { name, size = 16 } = Astro.props;
const paths: Record<Exclude<Props['name'], 'theme'>, string> = {
  'arrow-right': 'M3 8h10M8.5 3.5 13 8l-4.5 4.5',
  'arrow-left': 'M13 8H3m4.5-4.5L3 8l4.5 4.5',
  'arrow-up-right': 'M4 12l8-8M5.5 4H12v6.5',
  search: 'M7 11.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm6.5 2-3.3-3.3',
  menu: 'M2.5 4.5h11M2.5 8h11M2.5 11.5h11',
};
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'theme' ? (
      <>
        <circle cx="8" cy="8" r="5.5" />
        <path d="M8 2.5a5.5 5.5 0 0 1 0 11Z" fill="currentColor" stroke="none" />
      </>
    ) : (
      <path d={paths[name]} />
    )
  }
</svg>
