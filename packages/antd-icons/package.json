{
  "name": "@effectweb/antd-icons",
  "version": "0.8.1",
  "description": "Ant Design icons as direct DOM views for EffectWeb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerpyCrabs/EffectWeb.git",
    "directory": "packages/antd-icons"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./types": {
      "types": "./dist/attributes.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ant-design/icons-svg": "4.6.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.118",
    "effectweb": "^0.8.1"
  },
  "engines": {
    "node": ">=22.14"
  }
}
