{
  "name": "@effectweb/lucide",
  "version": "0.11.0",
  "description": "Lucide icons as direct DOM views for EffectWeb",
  "homepage": "https://github.com/DerpyCrabs/EffectWeb/tree/main/packages/lucide",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerpyCrabs/EffectWeb.git",
    "directory": "packages/lucide"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./dynamic": {
      "types": "./dist/dynamic.d.ts",
      "import": "./dist/dynamic.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lucide/icons": "1.49.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "effectweb": "0.11.0"
  },
  "engines": {
    "node": ">=22.14"
  }
}
