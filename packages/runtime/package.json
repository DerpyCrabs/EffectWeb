{
  "name": "effectweb",
  "version": "0.9.0",
  "description": "Immutable Effect models and compiled JSX with direct DOM rendering",
  "homepage": "https://github.com/DerpyCrabs/EffectWeb",
  "bugs": {
    "url": "https://github.com/DerpyCrabs/EffectWeb/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerpyCrabs/EffectWeb.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts",
      "import": "./dist/jsx.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "typescript": ">=5.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14"
  }
}
