{
  "name": "@effectweb/json-render",
  "version": "0.5.1",
  "description": "Consumer-defined json-render registries for EffectWeb",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
