      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@json-render/core": "0.21.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112",
    "effectweb": "^0.5.1"
  }
}
