{
  "name": "@effectweb/shadcn",
  "version": "0.14.1",
  "description": "shadcn/ui for EffectWeb: the upstream components on native elements, Tailwind CSS v4 and no React primitive library",
  "homepage": "https://github.com/DerpyCrabs/EffectWeb/tree/main/packages/shadcn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerpyCrabs/EffectWeb.git",
    "directory": "packages/shadcn"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "registry:build": "node ../../scripts/shadcn-registry.mjs",
    "registry:check": "node ../../scripts/shadcn-registry.mjs --check",
    "registry:serve": "node ../../scripts/shadcn-registry.mjs --serve"
  },
  "dependencies": {
    "@effectweb/base-ui": "0.14.1",
    "@effectweb/lucide": "0.14.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "effectweb": "0.14.1",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=22.14"
  }
}
